generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactLead {
  id        String   @id @default(cuid())
  nome      String
  email     String
  telefone  String
  servico   String
  detalhes  String?  @db.Text
  createdAt DateTime @default(now())
}