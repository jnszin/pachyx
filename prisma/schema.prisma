generator client {
  provider = "prisma-client-js"
    url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

// Esta é a tabela que vai guardar os contatos
model Lead {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  createdAt DateTime @default(now()) // Salva a data e hora automaticamente
}